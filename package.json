{
  "name": "dsh-compaction-policy",
  "version": "1.2.0",
  "description": "Applies one DSH compaction policy to every agent preset, regenerates the override from the installed DSH on each start, and edits every parameter — plus the summary's own thinking level — from Settings → Compaction.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wutong233/dsh-compaction-policy.git"
  },
  "homepage": "https://github.com/wutong233/dsh-compaction-policy#readme",
  "bugs": {
    "url": "https://github.com/wutong233/dsh-compaction-policy/issues"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "compaction",
    "plugin"
  ]
}
